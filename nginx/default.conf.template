server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # HTML / JS / 設定はキャッシュさせない(編集→リロードで即反映)
    location ~* \.(html|js)$ {
        add_header Cache-Control "no-cache";
    }
    # VRM(35MB程度)はキャッシュして起動を速く
    location /models/ {
        add_header Cache-Control "public, max-age=86400";
    }

    # 人検出の確認用画像 (perception の DEBUG_SNAPSHOT=1 で更新される)
    location /debug/ {
        add_header Cache-Control "no-store";
    }

    # iPhone などから話しかける入力ページ
    location = /remote {
        try_files /remote.html =404;
        add_header Cache-Control "no-cache";
    }

    # rosbridge (ROS 2 ⇔ ブラウザ)。rosbridge はホストネットワークで 9090 番
    location /rosbridge {
        proxy_pass http://host.docker.internal:9090/;   # rosbridge は / でしか受け付けないためパスを外す
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
    }

    # LiteLLM への中継。APIキーはここで付与し、ブラウザには渡さない
    location /llm/ {
        proxy_pass ${LITELLM_URL}/;
        proxy_set_header Authorization "Bearer ${LITELLM_KEY}";
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 120s;
    }
}
