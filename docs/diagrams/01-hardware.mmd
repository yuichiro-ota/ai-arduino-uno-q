---
config:
  layout: elk
  themeVariables:
    fontSize: 22px
  flowchart:
    nodeSpacing: 36
    rankSpacing: 60
---
%% 律(Ritsu) 機器の構成図 — 編集したら render.sh で PNG を作り直す
flowchart TB
  classDef dev fill:#eef6ff,stroke:#3b82f6,stroke-width:2px,color:#0f172a
  classDef mcu fill:#fff4e5,stroke:#f59e0b,stroke-width:2px,color:#0f172a
  classDef pwr fill:#fee2e2,stroke:#ef4444,stroke-width:2px,color:#0f172a
  classDef srv fill:#ecfdf5,stroke:#10b981,stroke-width:2px,color:#0f172a
  classDef usr fill:#f5f3ff,stroke:#8b5cf6,stroke-width:2px,color:#0f172a

  HUMAN(["話しかける人"]):::usr
  PHONE["スマホ・PC（補助）<br/>/remote ページ"]:::usr

  subgraph CART["台車 ＝ 律の体"]
    direction TB
    subgraph IO["USB 機器"]
      direction LR
      SPK["スピーカーフォン<br/>＝ 耳と口"]:::dev
      CAM["深度カメラ<br/>＝ 目"]:::dev
      MON["縦置きモニター<br/>＝ 画面の律"]:::dev
    end
    subgraph UNOQ["Arduino UNO Q"]
      direction LR
      MPU["Linux 側<br/>見る・考える・話す<br/>Docker + ROS 2"]:::dev
      MCU["マイコン側<br/>車輪を回す<br/>STM32"]:::mcu
    end
    subgraph LEGS["足回り"]
      direction LR
      BAT["バッテリー<br/>12V"]:::pwr
      DRV["モーター<br/>ドライバー ×2"]:::mcu
      MOT["メカナム車輪 ×4<br/>エンコーダー付き"]:::mcu
    end
  end

  subgraph SRV["サーバー（GPU）"]
    direction TB
    LLM["LLM<br/>LiteLLM → Ollama"]:::srv
    VOICE["音声<br/>Whisper・VOICEVOX"]:::srv
  end

  HUMAN <-->|声で会話| SPK
  HUMAN -.->|顔・姿| CAM
  PHONE -.->|Wi-Fi| MPU
  IO <-->|USB| MPU
  MPU <-->|Bridge| MCU
  MPU <-->|HTTP| SRV
  MCU <-->|指令・回転数| DRV
  BAT ==> DRV
  DRV --> MOT
